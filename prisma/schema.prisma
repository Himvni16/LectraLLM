generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnalysisStatus {
  UPLOADED
  TRANSCRIBING
  EXTRACTING_PDF
  EXTRACTING_TOPICS
  COMPARING
  COMPLETED
  FAILED
}

enum TopicSource {
  VIDEO
  PDF
}

enum MatchType {
  STRONG
  PARTIAL
  WEAK
  MISSING
}

model Analysis {
  id                     String         @id @default(cuid())
  videoFileName          String
  pdfFileName            String
  videoStoragePath       String
  pdfStoragePath         String
  status                 AnalysisStatus @default(UPLOADED)
  transcriptText         String?        @db.Text
  pdfText                String?        @db.Text
  overallSimilarityScore Decimal?       @db.Decimal(5, 2)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  topics                 Topic[]
  topicMatches           TopicMatch[]

  @@index([status])
}

model Topic {
  id              String       @id @default(cuid())
  analysisId      String
  name            String
  source          TopicSource
  confidenceScore Decimal?     @db.Decimal(5, 4)
  createdAt       DateTime     @default(now())
  analysis        Analysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  videoMatches    TopicMatch[] @relation("VideoTopicMatches")
  pdfMatches      TopicMatch[] @relation("PdfTopicMatches")

  @@index([analysisId])
  @@index([source])
}

model TopicMatch {
  id              String    @id @default(cuid())
  analysisId      String
  videoTopicId    String
  pdfTopicId      String
  similarityScore Decimal   @db.Decimal(5, 4)
  matchType       MatchType
  createdAt       DateTime  @default(now())
  analysis        Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  videoTopic      Topic     @relation("VideoTopicMatches", fields: [videoTopicId], references: [id], onDelete: Cascade)
  pdfTopic        Topic     @relation("PdfTopicMatches", fields: [pdfTopicId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}
