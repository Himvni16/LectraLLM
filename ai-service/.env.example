# Comma-separated origins allowed to call this service. Replace these local
# origins with the deployed Next.js origin in production.
AI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local faster-whisper configuration. The model is loaded on first use.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Maximum media upload accepted by POST /transcribe, in MiB.
TRANSCRIPTION_MAX_SIZE_MB=250

# Match the web app's PDF_MAX_SIZE_MB value.
PDF_MAX_SIZE_MB=25

# Phase 5 topic extraction. Keep the API key only in ai-service/.env or the
# AI service's server-side secret store. Never expose it to Next.js or a browser.
TOPIC_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TOPIC_MODEL=gemini-3.5-flash-lite

# Maximum characters sent in one topic-extraction model request.
TOPIC_CHUNK_CHARS=12000

# Phase 6 local semantic-comparison model. Downloaded on first comparison.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
