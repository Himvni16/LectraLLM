# Comma-separated origins allowed to call this service.
AI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local faster-whisper configuration. The model is loaded on first use.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Maximum media upload accepted by POST /transcribe, in MiB.
TRANSCRIPTION_MAX_SIZE_MB=250

# Match the web app's PDF_MAX_SIZE_MB value.
PDF_MAX_SIZE_MB=25
