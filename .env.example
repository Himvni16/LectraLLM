# Server-only values. Replace placeholders locally; never commit real credentials.
DATABASE_URL="postgresql://username:password@pooled-host/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@direct-host/neondb?sslmode=require"
AI_SERVICE_URL="http://127.0.0.1:8000"

# Direct Gemini topic extraction in the Next.js server runtime.
GEMINI_API_KEY="replace-with-a-gemini-api-key"
GEMINI_TOPIC_MODEL="gemini-3.5-flash-lite"
TOPIC_CHUNK_CHARS="12000"

# Direct Gemini embeddings for deterministic server-side topic comparison.
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
GEMINI_EMBEDDING_DIMENSIONS="768"

# Development upload limits in mebibytes (MiB).
VIDEO_MAX_SIZE_MB="100"
PDF_MAX_SIZE_MB="25"

# Maximum time the web app waits for the local AI transcription service.
AI_TRANSCRIPTION_TIMEOUT_SECONDS="1800"

# Cloudinary Free video storage. Keep the API secret server-only.
CLOUDINARY_CLOUD_NAME="replace-with-cloud-name"
CLOUDINARY_API_KEY="replace-with-api-key"
CLOUDINARY_API_SECRET="replace-with-api-secret"
CLOUDINARY_UPLOAD_FOLDER="lectrallm/videos"

# Supabase Free private PDF storage. Keep the service-role key server-only.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_STORAGE_BUCKET="lectrallm-pdfs"
