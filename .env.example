# Server-only Supabase PostgreSQL credentials. Replace placeholders locally; never commit real credentials.
# DATABASE_URL is the Supabase transaction-pooler URL used by the application runtime and custom migration runner.
# The pg configuration strips URL SSL parameters in memory and enables TLS explicitly with rejectUnauthorized=false for this endpoint.
DATABASE_URL="postgresql://postgres.project-ref:password@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL is optional for Prisma CLI operations that require a direct/session connection; the custom migration runner does not use it.
DIRECT_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require"
# Retained FastAPI health-proxy URL; production analysis stages do not call it.
AI_SERVICE_URL="http://127.0.0.1:8000"

# Direct Gemini transcription, topic extraction, and comparison in Next.js.
GEMINI_API_KEY="replace-with-a-gemini-api-key"
GEMINI_TRANSCRIPTION_MODEL="gemini-3.8-flash"
GEMINI_TOPIC_MODEL="gemini-3.5-flash-lite"
TOPIC_CHUNK_CHARS="12000"

# Direct Gemini embeddings for deterministic server-side topic comparison.
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
GEMINI_EMBEDDING_DIMENSIONS="768"

# Development upload limits in mebibytes (MiB).
VIDEO_MAX_SIZE_MB="100"
PDF_MAX_SIZE_MB="25"

# Maximum time allowed for the Gemini video upload, processing, and transcript.
AI_TRANSCRIPTION_TIMEOUT_SECONDS="1800"

# Cloudinary Free video storage. Keep the API secret server-only.
CLOUDINARY_CLOUD_NAME="replace-with-cloud-name"
CLOUDINARY_API_KEY="replace-with-api-key"
CLOUDINARY_API_SECRET="replace-with-api-secret"
CLOUDINARY_UPLOAD_FOLDER="lectrallm/videos"

# Supabase private PDF Storage/API credentials. These are not PostgreSQL connection URLs.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_STORAGE_BUCKET="lectrallm-pdfs"
