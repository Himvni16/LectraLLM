# Pooled Neon URL for application/runtime queries.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require&connect_timeout=30&pool_timeout=30"

# Direct Neon URL for Prisma CLI, migrations, and administrative operations.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-ENDPOINT.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require&connect_timeout=30"

# Base URL of the local FastAPI service. Do not include a trailing slash.
AI_SERVICE_URL="http://127.0.0.1:8000"

# Development upload limits in mebibytes (MiB).
VIDEO_MAX_SIZE_MB="250"
PDF_MAX_SIZE_MB="25"

# Maximum time the web app waits for the local AI transcription service.
AI_TRANSCRIPTION_TIMEOUT_SECONDS="1800"
