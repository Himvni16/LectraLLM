# PostgreSQL connection used by Prisma. Replace with your local credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lectrallm?schema=public"

# Base URL of the local FastAPI service. Do not include a trailing slash.
AI_SERVICE_URL="http://127.0.0.1:8000"

# Development upload limits in mebibytes (MiB).
VIDEO_MAX_SIZE_MB="250"
PDF_MAX_SIZE_MB="25"

# Maximum time the web app waits for the local AI transcription service.
AI_TRANSCRIPTION_TIMEOUT_SECONDS="1800"
